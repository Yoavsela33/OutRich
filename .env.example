# Primary LLM — Claude (required unless GEMINI_API_KEY is set)
ANTHROPIC_API_KEY=

# Fallback LLM — Gemini
GEMINI_API_KEY=

# Lead discovery — Apify (required for --source apify)
APIFY_TOKEN=

# External enrichment — Google Custom Search (optional; pipeline degrades gracefully without it)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Optional overrides
# CLAUDE_MODEL=claude-sonnet-4-6
# GEMINI_MODEL=gemini-1.5-flash
# APIFY_ACTOR=harvestapi/linkedin-profile-search
